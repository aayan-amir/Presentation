---
import type {Project} from '../projects';
import {asset} from '../projects';
interface Props {project:Project; story:string[]}
const {project,story} = Astro.props;
const controls=['West','Zenith','East'];
---
<section class="exhibit" aria-label={project.title}>
  <div class="caption"><h1>Signal<br/> Field</h1></div>
  <div class="instrument">
    <figure class="specimen">
      <img class="primary-art" src={asset(project,project.entry)} alt="Chrome helix in a dark optical chamber" width="1100" height="840" fetchpriority="high" />
    </figure>
    <div class="selector" role="group" aria-label="Sweep the light">
      <p class="control-title">Sweep the light</p>
      <div class="tabs">{controls.map((control,index) => <button type="button" data-state={index+1} aria-pressed={project.entry===index+1}>{control}</button>)}</div>
    </div>
  </div>
  <aside class="scale" aria-hidden="true"><i></i><span class="mono" data-angle>0°</span></aside>
</section>
<section class="notes">
  <h2>Reading the reflection</h2>
  <div class="proofs">{controls.map((control,index) => (
    <figure><img src={asset(project,`${index+1}-small`)} alt={`Chrome reflection lit from ${control.toLowerCase()}`} width="520" height="397" loading="lazy" /><figcaption class="mono">{control}</figcaption></figure>
  ))}</div>
  <p class="observation" data-reading aria-live="polite">{story[project.entry-1]}</p>
</section>
